{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "playwright-core/lib/*": ["./playwright/packages/playwright-core/src/*"],
      "playwright/lib/*":      ["./playwright/packages/playwright/src/*"],
      "@playwright/*":         ["./playwright/packages/playwright/src/*"],
      "@protocol/*":           ["./playwright/packages/protocol/src/*"],
      "@utils/*":              ["./playwright/packages/utils/*"],
      "@isomorphic/*":         ["./playwright/packages/isomorphic/*"],
      "@recorder/*":           ["./playwright/packages/recorder/src/*"],
      "@trace/*":              ["./playwright/packages/trace/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
